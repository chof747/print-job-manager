{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend Debug",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "module": "uvicorn",
      "args": [
        "backend.app.main:app",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "subProcess": true,
      "justMyCode": true
    },
    {
      "name": "Frontend Debug",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "Start frontend dev server"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack Debug",
      "configurations": [
        "Backend Debug",
        "Frontend Debug"
      ],
      "stopAll": true
    }
  ]
}
