{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start frontend dev server",
      "type": "shell",
      "command": "pnpm run dev:frontend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": [
          {
            "regexp": "^(.*):(\\d+):(\\d+):\\s*(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*(Local:|ready in).*"
        }
      },
      "presentation": {
        "group": "frontend",
        "panel": "dedicated",
        "reveal": "always"
      }
    }
  ]
}
