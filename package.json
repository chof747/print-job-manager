{
  "name": "print-job-manager",
  "version": "1.0.0",
  "description": "A managing app that allows planning of 3d printing jobs based on projects and a prioritised list of models",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "check:backend": "python3 -m pytest backend/tests -q",
    "check:frontend": "vitest run frontend/",
    "dev:backend": "python3 -m uvicorn backend.app.main:app --reload",
    "dev:frontend": "vite frontend",
    "sandcastle": "tsx --env-file=.sandcastle/.env .sandcastle/main.mts",
    "sandcastle:docker": "SANDCASTLE_SANDBOX=docker tsx --env-file=.sandcastle/.env .sandcastle/main.mts",
    "sandcastle:dry-run": "SANDCASTLE_DRY_RUN=true tsx --env-file=.sandcastle/.env .sandcastle/main.mts",
    "prototype:ui-look-feel": "node scripts/serve-ui-look-feel-prototype.mjs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chof747/print-job-manager.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/chof747/print-job-manager/issues"
  },
  "homepage": "https://github.com/chof747/print-job-manager#readme",
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
